ight":1664},{"ratio_type":8,"width":3024,"height":1296}],"image_range_config":{"min_length":1296,"max_length":3024,"max_pixel_num":4194304},"resolution_name":"高清 2K"}},"icon_url_svg":"https://p26-dreamina-sign.byteimg.com/tos-cn-i-tb4s082cfz/model-dreamina.svg~tplv-tb4s082cfz-image.image?lk3s=8e790bc3\u0026x-expires=1819961594\u0026x-signature=xmYkGnmR0uIp8uuLf4PHhBDYbCc%3D","pre_audit_policy":"","subject_pre_audit_policy":""},"prompt":"动态角度，颗粒感，肌理感，艺术氛围感加强，厚涂+晕染水粉，颜料的涂抹感+肌理感，超现实主义美学，高级的氛围感，层次感，矛盾冲突的视觉冲击和有机融合。画面不经意的刀刮刻痕，质感和肌理，深刻，内部张力，朦胧斑驳美学，似是而非的呈现，不确定的主题，二次嚗光，情绪渗透，叙事和故事，隐喻式，，承载对人性、苦难、命运的深度，完成哲学表达，模糊人影故障风格，VHS故障风格，数字故障效果，大景深，黑白尽头，灰蓝色背景，视觉冲击力，暗黑风格，大风，高大武士，威武雄壮，头发凌乱。","sample_steps":16,"large_image_info":{"height":2560,"width":1440,"resolution_type":"2k"},"sample_strength":0.5},"template_id":"7653016371948801307","aigc_mode":"workbench","insta_drag_params":{"origin_item_id":null},"hide_ref_images":false,"reference_prompt":"超现实主义美学，暗黑风格，动态角度，大景深，灰蓝色背景，黑白尽头，视觉冲击力。高大武士威武雄壮，头发凌乱，在大风中，模糊人影故障风格，VHS故障风格，数字故障效果。厚涂+晕染水粉，颜料涂抹感，肌理感，颗粒感，艺术氛围感，刀刮刻痕，内部张力，朦胧斑驳美学，似是而非的呈现，不确定的主题，二次曝光，情绪渗透，叙事和故事，隐喻式，承载对人性、苦难、命运的深度哲学表达，层次感，矛盾冲突的视觉冲击和有机融合。","image_type":3},"statistic":{"usage_num":12,"favorite_num":149,"play_num":0},"category_id_list":[],"aigc_flow":{"version":"3.2.8"},"ref_item":{"common_attr":{"id":"7653016371948801307","effect_id":"7653016371948801307","effect_type":9,"description":"","cover_url":"https://p26-dreamina-sign.byteimg.com/tos-cn-i-tb4s082cfz/8be91dfcc4034522be69c7434a93dd33~tplv-tb4s082cfz-aigc_resize:640:640.jpeg?lk3s=4fa96020\u0026x-expires=1819961597\u0026x-signature=qZI76IiJgpRgrbtPJkVVlKP7mlk%3D","cover_url_map":null,"smart_crop_loc":null,"status":102,"title":""},"author":{"name":"明心","avatar_url":"https://p3-faceu-img-sign.byteimg.com/tos-cn-i-tb4s082cfz/0f0ea97f166a407db80d8296fa169101~tplv-resize:200:200.webp?lk3s=4eecb9e8\u0026x-expires=1791017597\u0026x-signature=W%2FGhPT74jkIGJrbTaqo5FxGpGsk%3D","uid":"2619503111577068","sec_uid":"MS4wLjABAAAANJXsljcgtQef9T_W8V