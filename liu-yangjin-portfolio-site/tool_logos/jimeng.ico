白，哑光质感，简洁线条，90年代复古美学。一个平面抽象变形的扁平不完美粉色芭乐切面。画面上方极小极细无衬线字体\"Art\"、\"Design\"、\"Idea\"，左下角极小标注\"来佬野-AIGC\"，右下角极小标注\"更多前沿玩法等你探索\"。","image_type":3},"statistic":{"usage_num":47,"favorite_num":447,"play_num":0},"category_id_list":[],"aigc_flow":{"version":"3.0.2"},"ref_item":{"common_attr":{"id":"7649285895308299529","effect_id":"7649285895308299529","effect_type":9,"description":"","cover_url":"https://p26-dreamina-sign.byteimg.com/tos-cn-i-tb4s082cfz/8eb1718e0205420c9ee359fb21fab7a8~tplv-tb4s082cfz-aigc_resize:640:640.jpeg?lk3s=4fa96020\u0026x-expires=1819961597\u0026x-signature=er7gDhFSCDKkccOkqikioo3VlOE%3D","cover_url_map":null,"smart_crop_loc":null,"status":102,"title":"插画"},"author":{"name":"来佬野- AIGC","avatar_url":"https://p6-faceu-img-sign.byteimg.com/tos-cn-i-tb4s082cfz/df227254e52e44edbf35bcfba6a3e51d~tplv-resize:200:200.webp?lk3s=4eecb9e8\u0026x-expires=1791017597\u0026x-signature=y7Ws5C6ZZIemzbzvMK7QcSMutrc%3D","uid":"3367155394952361","sec_uid":"MS4wLjABAAAA2yVlghOH3gONHyoWS0Nh9c26YDAzgizFLwZGNRaIetsaAhFZtmlREdzyxYlWCodE","description":"AIGC艺术创作团队/创意设计\n多样化创作风格｜全应用场景设计\n更多创意教学关注小红书：来佬野-AIGC","has_followed":false,"followed_req_uid":false,"status":0,"account_type":0,"work_allowed_share":true,"is_virtual":false},"feature":"","extra":{"template_type":"image","ai_feature":"text_generate_image"}},"aigc_draft":{"version":"3.0.2","uri":"aigc-draft/15226352886284","content":"{\"type\":\"draft\",\"id\":\"970c8238-b494-4c71-92f1-3c177de725fe\",\"min_version\":\"3.0.2\",\"min_features\":[],\"is_from_tsn\":true,\"version\":\"3.0.2\",\"main_component_id\":\"fe615f49-e6a9-477a-acd7-9d5f5f7075f8\",\"component_list\":[{\"type\":\"image_base_component\",\"id\":\"fe615f49-e6a9-477a-acd7-9d5f5f7075f8\",\"min_version\":\"3.0.2\",\"aigc_mode\":\"workbench\",\"gen_type\":1,\"metadata\":{\"type\":\"\",\"id\":\"1e7a054e-f9fd-4e71-9c81-e9e8ce0ba143\",\"created_platform\":2,\"created_platform_version\":\"1701600\",\"created_time_in_ms\":\"1782909244305\",\"created_did\":\"\"},\"generat