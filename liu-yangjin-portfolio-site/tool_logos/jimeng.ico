el_bg_prompt_starling_key":"","resolution_map":{"1k":{"image_ratio_sizes":[{"ratio_type":1,"width":1328,"height":1328},{"ratio_type":2,"width":1104,"height":1472},{"ratio_type":3,"width":1664,"height":936},{"ratio_type":4,"width":1472,"height":1104},{"ratio_type":5,"width":936,"height":1664},{"ratio_type":6,"width":1056,"height":1584},{"ratio_type":7,"width":1584,"height":1056},{"ratio_type":8,"width":2016,"height":864}],"image_range_config":{"min_length":512,"max_length":2016,"max_pixel_num":1763584},"resolution_name":"标清 1K"},"2k":{"image_ratio_sizes":[{"ratio_type":1,"width":2048,"height":2048},{"ratio_type":2,"width":1728,"height":2304},{"ratio_type":3,"width":2560,"height":1440},{"ratio_type":4,"width":2304,"height":1728},{"ratio_type":5,"width":1440,"height":2560},{"ratio_type":6,"width":1664,"height":2496},{"ratio_type":7,"width":2496,"height":1664},{"ratio_type":8,"width":3024,"height":1296}],"image_range_config":{"min_length":1296,"max_length":3024,"max_pixel_num":4194304},"resolution_name":"高清 2K"}},"icon_url_svg":"https://p26-dreamina-sign.byteimg.com/tos-cn-i-tb4s082cfz/model-dreamina.svg~tplv-tb4s082cfz-image.image?lk3s=8e790bc3\u0026x-expires=1819961594\u0026x-signature=xmYkGnmR0uIp8uuLf4PHhBDYbCc%3D","pre_audit_policy":"","subject_pre_audit_policy":""},"prompt":"Adam Riches风格作品，妖魔化孙悟空，精密线条，以单线连续线条绘画，让木炭在纸上游走成即兴的排线，他的线条时而密集，时而疏朗，构筑立体感，层层叠叠，这些看似无序的线条轨迹，最终重构出古典巴洛克风格与极繁主义叙事。\n拟人国风雕，神秘感，华丽炫酷的花纹和质感、冷色调，整个画面散发出一种美轮美奂的诡异气质，惊艳迷人却又令人感觉到危险和恐惧，极致的细节刻画，极致的立体纹理，奢华、繁琐、恢弘、大气，超高清画质。妖魔化孙悟空，琉璃圣体。超广角构图，张力十足，压迫感，细节生动完美。极其震撼的一幕，视觉冲击力强，明暗对比强烈，阴影过渡自然，电影级构图，视觉冲击，8K画质，超清，极致细节，清晰的线条，高对比，大师级别的作品。立体渲染，精细画笔，色彩搭配和谐融洽，超细腻笔触，线条流畅，超清画质，完美品质，高质量，自适应饱和度，专业级打光，大师杰作，自由视角，阴影过渡自然，氛围感，高级感，唯美，宿命感拉满，画面具有层次感。视觉冲击，故事感，高级感，动态感。镭射放射状闪光勾线及背景。\n","seed":2570131133,"user_negative_prompt":"","large_image_info":{"height":1664,"width":936,"resolution_type":"1k"},"sample_strength":0.5,"use_pe":false,"schedule_conf":"base","actual_prompt":"Adam Riches风格作品，妖魔化孙悟空，精密线条，以单线连续线条绘画，让木炭在纸上游走成即兴的排线，他的线条时而密集，时而疏朗