mpty_prompt","byte_edit_with_custom_ratio","etta","support_subject"],"model_name":"图片 4.7","model_tip":"画质全面优化，指令响应能力再次提升","feature_key":"","generation_category_name_starling_key":"dreamina_app_modalswitch_image_43","generation_category_name":"4.7","duration_option":null,"lens_motion_type_option":null,"motion_speed_option":null,"camera_strength_option":null,"video_aspect_ratio_option":null,"fps":0,"feat_config":{"canny":{"strength":0.6},"depth":{"strength":0.6},"pose":{"strength":0.6},"style_reference":{"strength":0.8}},"extra":{"model_source":"by Seedream 4.7","raw_model_source":"Seedream 4.3 Design"},"feats_cant_combine":[],"model_bg_prompt_starling_key":"","resolution_map":{"2k":{"image_ratio_sizes":[{"ratio_type":1,"width":2048,"height":2048},{"ratio_type":2,"width":1728,"height":2304},{"ratio_type":3,"width":2560,"height":1440},{"ratio_type":4,"width":2304,"height":1728},{"ratio_type":5,"width":1440,"height":2560},{"ratio_type":6,"width":1664,"height":2496},{"ratio_type":7,"width":2496,"height":1664},{"ratio_type":8,"width":3024,"height":1296}],"image_range_config":{"min_length":1296,"max_length":3024,"max_pixel_num":4194304},"resolution_name":"高清 2K"}},"icon_url_svg":"https://p26-dreamina-sign.byteimg.com/tos-cn-i-tb4s082cfz/model-dreamina.svg~tplv-tb4s082cfz-image.image?lk3s=8e790bc3\u0026x-expires=1819961594\u0026x-signature=xmYkGnmR0uIp8uuLf4PHhBDYbCc%3D","pre_audit_policy":"","subject_pre_audit_policy":""},"prompt":"人物形象提示词：（三视图）\n1.主视觉区 (上方)以 \"正面 + 侧面 + 背面\" 三个核心视角为主体，直观呈现角色的整体身形、服饰搭配和标志性特征，是制作人员对人物 \"整体造型\" 的参考基础。\n2.补充信息区 (左侧)拆分出 \"面部特写\" 和 \"配色板\"(明确毛发、服饰的色值)，补充主视角没覆盖的细节与色彩标准。\n3.局部细节区 (底部)用小模块单独展示关键部件的设计 (配饰、点缀、关键身份识别元素)，把主视角里的 \"模糊细节\" 拆分为精准的制作参考，方便导演确认。\n4.全身照比例照 (右侧)使用黄金比例（9头身）参考物和人物身高形成对比。\n5.背景为白色，最高品质细节丰富。\n6【真人写实】超写实国风，现代风格，写实风格，质感光照，自然光线，质感十足，8K高清纹理，布料褶皱自然，艺术写实风格，营造出震撼惊艳的视觉效果。                                                \n 人物外观设定:古风帅哥，三庭五眼，氛围感白发，发丝细腻柔顺，狭长双眼，眼尾细长，睫毛浓密纤长。\n服饰首饰：锦衣华服貂裘，丰富的花纹，金丝描边，金质华丽的发冠，\n五官容貌：极致妖孽魅惑的容貌，饱和度较高，高级构图，细节丰富，清晰精致，精致细腻，高清画质，长发凌乱发丝拂面，面部聚焦，面部阴影，绝美眼睛，线条清晰，高级感、朦胧感、面部清晰，正面，清透瓷白的肌肤，保留皮肤纹理，明暗对比，超高清、最高画质、高质量，丰富细节、细腻肌理，疯批感，有柔和感情的眼神，阴郁感，忧郁感，清冷感，超细节，超丰富，写实逼真，潇洒","sample_steps":16,"large_image_info":{"height":2560,"width":1440,"resolution_type":"2k"},"sample_strength":0.5},"template_id":"7639975767635512603","aigc_mode":"workbench","insta_drag_params":{"origin_item_id":null},"hide_ref_images":false,"reference_prompt":"超写实国风，现代风格，写实风格，质感光照，自然光线，8K高清纹理，布料褶皱自然，艺术写实风格。白色背景，最高品质细节丰富。主视觉区上方为\"正面+侧面+背面\"三个核心视角，直观呈现古风帅哥整体身形、锦衣华服貂裘搭配和标志性特征；左侧补充信息区拆分\"面部特写\"和\"配色板\"，明确毛发、服饰色值；底部局部细节区用小模块单独展示金质华丽发冠、配饰等关键部件设计；右侧全身照比例照使用9头身黄金比例参考物与人物身高形成对比。古风帅哥三庭五眼，氛围感白发发丝细腻柔顺，狭长双眼眼尾细长，睫毛浓密纤长，极致妖孽魅惑容貌，饱和度较高，长发凌乱发丝拂面，面部聚焦有阴影，清透瓷白肌肤保留纹理，明暗对比，眼神柔和带阴郁清冷疯批感，潇洒气质。","image_type":3},"statistic":{"usage_num":169,"favorite_num":212,"play_num":0},"category_id_list":[],"aigc_flow":{"version":"3.0.2"},"ref_item":{"common_attr":{"id":"7639975767635512603","effect_id":"7639975767635512603","effect_type":9,"description":"三视图，做同款自觉点赞","cover_url":"https://p11-dreamina-sign.byteimg.com/tos-cn-i-tb4s082cfz/e6b055c92ecd46309b99b2369da4ccfb~tplv-tb4s082cfz-aigc_resize:640:640.jpeg?lk3s=4fa96020\u0026x-expires=1819961597\u0026x-signature=PykSSlKyjLY1O%2FTf2UkWKknhS70%3D","cover_url_map":null,"smart_crop_loc":null,"status":102,"title":""},"author":{"name":"落落丶","avatar_url":"https://p6-passport.byteacctimg.com/img/user-avatar/b66cf9f044aa668fe0e880b44e679762~300x300.image","uid":"2454546683805341","sec_uid":"MS4wLjABAAAAVCZDhb4pOj_RfH89Xzy5FVn8etcGpqugWSqB6-JrMw65NqC99A564E8hpMA5ieGr","description":"","has_followed":false,"followed_req_uid":false,"status":0,"account_type":0},"feature":"","extra":{"template_type":"image","ai_feature":"text_generate_image"}},"comment_info":{"link_comment_id":"7667726548183171864"},"aigc_draft":{"version":"3.0.2","uri":"aigc-draft/17569930561804","content":"{\"type\":\"draft\",\"id\":\"a32fcef9-b657-4412-838b-98b76d0eb963\",\"min_version\":\"3.0.2\",\"min_features\":[],\"is_from_tsn\":true,\"version\":\"3.0.2